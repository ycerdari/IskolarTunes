@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
    Layout = "_AuthLayout";
}

<div class="it-auth-card">
    <a class="it-auth-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <span class="it-auth-logo" aria-hidden="true">I</span>
        <span>IskolarTunes</span>
    </a>

    <h1 class="it-auth-title">Password reset</h1>
    <p class="it-auth-sub">Your password has been reset. You can now sign in.</p>

    <a class="it-auth-go" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
</div>