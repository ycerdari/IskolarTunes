@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
    ViewData["ReturnUrl"] = Model.ReturnUrl;
    ViewData["ExternalHeading"] = "Or sign in with";
}

<div class="it-auth-card">
    <a class="it-auth-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <span class="it-auth-logo" aria-hidden="true">I</span>
        <span>IskolarTunes</span>
    </a>

    <nav class="it-auth-tabs" aria-label="Account">
        <a class="it-auth-tab active" aria-current="page" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">SIGN IN</a>
        <a class="it-auth-tab" asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">SIGN UP</a>
    </nav>

    <form id="account" method="post" class="it-auth-form">
        <div asp-validation-summary="ModelOnly" class="it-auth-alert" role="alert"></div>

        <div class="it-auth-field">
            <input asp-for="Input.Email" type="email" class="it-auth-in" autocomplete="username" aria-label="Email" placeholder="Email" />
            <span asp-validation-for="Input.Email" class="it-auth-err"></span>
        </div>

        <div class="it-auth-field">
            <input asp-for="Input.Password" type="password" class="it-auth-in" autocomplete="current-password" aria-label="Password" placeholder="Password" />
            <span asp-validation-for="Input.Password" class="it-auth-err"></span>
        </div>

        <label asp-for="Input.RememberMe" class="it-auth-chk">
            <input asp-for="Input.RememberMe" type="checkbox" />
            Stay signed in
        </label>

        <button id="login-submit" type="submit" class="it-auth-go">Sign in</button>
    </form>

    <partial name="_ExternalLoginButtons" model="Model.ExternalLogins" />

    <a class="it-auth-link" asp-area="Identity" asp-page="/Account/ForgotPassword">Forgot password?</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}