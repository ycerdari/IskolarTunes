@page
@model RegisterModel
@{
    ViewData["Title"] = "Sign up";
    Layout = "_AuthLayout";
    ViewData["ReturnUrl"] = Model.ReturnUrl;
    ViewData["ExternalHeading"] = "Or sign up with";
}

<div class="it-auth-card">
    <a class="it-auth-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <span class="it-auth-logo" aria-hidden="true">I</span>
        <span>IskolarTunes</span>
    </a>

    <nav class="it-auth-tabs" aria-label="Account">
        <a class="it-auth-tab" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">SIGN IN</a>
        <a class="it-auth-tab active" aria-current="page" asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">SIGN UP</a>
    </nav>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="it-auth-form">
        <div asp-validation-summary="ModelOnly" class="it-auth-alert" role="alert"></div>

        <div class="it-auth-field">
            <input asp-for="Input.FullName" class="it-auth-in" autocomplete="name" aria-label="Full name" placeholder="Full name" />
            <span asp-validation-for="Input.FullName" class="it-auth-err"></span>
        </div>

        <div class="it-auth-field">
            <input asp-for="Input.Email" type="email" class="it-auth-in" autocomplete="username" aria-label="Email" placeholder="Email" />
            <span asp-validation-for="Input.Email" class="it-auth-err"></span>
        </div>

        <div class="it-auth-field">
            <input asp-for="Input.Password" type="password" class="it-auth-in" autocomplete="new-password" aria-label="Password" placeholder="Password" />
            <span asp-validation-for="Input.Password" class="it-auth-err"></span>
        </div>

        <div class="it-auth-field">
            <input asp-for="Input.ConfirmPassword" type="password" class="it-auth-in" autocomplete="new-password" aria-label="Confirm password" placeholder="Confirm password" />
            <span asp-validation-for="Input.ConfirmPassword" class="it-auth-err"></span>
        </div>

        <button id="registerSubmit" type="submit" class="it-auth-go">Create account</button>
    </form>

    <partial name="_ExternalLoginButtons" model="Model.ExternalLogins" />

    <span class="it-auth-or">Already have an account?</span>
    <a class="it-auth-link it-auth-link-strong" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}