@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = "_AuthLayout";
}

<div class="it-auth-card">
    <a class="it-auth-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <span class="it-auth-logo" aria-hidden="true">I</span>
        <span>IskolarTunes</span>
    </a>

    <h1 class="it-auth-title">Two-factor authentication</h1>
    <p class="it-auth-sub">Enter the 6-digit code from your authenticator app.</p>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="it-auth-form">
        <input asp-for="RememberMe" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="it-auth-alert" role="alert"></div>

        <div class="it-auth-field">
            <input asp-for="Input.TwoFactorCode" class="it-auth-in it-auth-code" inputmode="numeric" maxlength="6"
                   autocomplete="off" aria-label="Authenticator code" placeholder="000000" />
            <span asp-validation-for="Input.TwoFactorCode" class="it-auth-err"></span>
        </div>

        <label asp-for="Input.RememberMachine" class="it-auth-chk">
            <input asp-for="Input.RememberMachine" type="checkbox" />
            Remember this device
        </label>

        <button type="submit" class="it-auth-go">Verify</button>
    </form>

    <a class="it-auth-link" asp-area="Identity" asp-page="/Account/LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Use a recovery code instead</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}