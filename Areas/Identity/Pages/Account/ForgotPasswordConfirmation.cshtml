@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}

<div class="it-auth-card">
    <a class="it-auth-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <span class="it-auth-logo" aria-hidden="true">I</span>
        <span>IskolarTunes</span>
    </a>

    <h1 class="it-auth-title">Check your email</h1>
    <p class="it-auth-sub">If an account exists for that email, a password reset link is on its way.</p>

    <a class="it-auth-go" asp-area="Identity" asp-page="/Account/Login">Back to sign in</a>
</div>