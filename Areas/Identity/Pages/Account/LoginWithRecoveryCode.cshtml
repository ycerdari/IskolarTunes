@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code";
    Layout = "_AuthLayout";
}

<div class="it-auth-card">
    <a class="it-auth-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <span class="it-auth-logo" aria-hidden="true">I</span>
        <span>IskolarTunes</span>
    </a>

    <h1 class="it-auth-title">Recovery code</h1>
    <p class="it-auth-sub">Enter one of the recovery codes you saved when you set up two-factor authentication.</p>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="it-auth-form">
        <div asp-validation-summary="ModelOnly" class="it-auth-alert" role="alert"></div>

        <div class="it-auth-field">
            <input asp-for="Input.RecoveryCode" class="it-auth-in" autocomplete="off" aria-label="Recovery code" placeholder="Recovery code" />
            <span asp-validation-for="Input.RecoveryCode" class="it-auth-err"></span>
        </div>

        <button type="submit" class="it-auth-go">Verify</button>
    </form>

    <a class="it-auth-link" asp-area="Identity" asp-page="/Account/Login">Back to sign in</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}