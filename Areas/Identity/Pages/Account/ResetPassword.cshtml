@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}

<div class="it-auth-card">
    <a class="it-auth-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <span class="it-auth-logo" aria-hidden="true">I</span>
        <span>IskolarTunes</span>
    </a>

    <h1 class="it-auth-title">Choose a new password</h1>
    <p class="it-auth-sub">Confirm your email, then pick a new password.</p>

    <form method="post" class="it-auth-form">
        <div asp-validation-summary="ModelOnly" class="it-auth-alert" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />

        <div class="it-auth-field">
            <input asp-for="Input.Email" type="email" class="it-auth-in" autocomplete="username" aria-label="Email" placeholder="Email" />
            <span asp-validation-for="Input.Email" class="it-auth-err"></span>
        </div>

        <div class="it-auth-field">
            <input asp-for="Input.Password" type="password" class="it-auth-in" autocomplete="new-password" aria-label="New password" placeholder="New password" />
            <span asp-validation-for="Input.Password" class="it-auth-err"></span>
        </div>

        <div class="it-auth-field">
            <input asp-for="Input.ConfirmPassword" type="password" class="it-auth-in" autocomplete="new-password" aria-label="Confirm new password" placeholder="Confirm new password" />
            <span asp-validation-for="Input.ConfirmPassword" class="it-auth-err"></span>
        </div>

        <button type="submit" class="it-auth-go">Reset password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}