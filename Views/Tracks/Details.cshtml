@using System.Security.Claims
@model Track
@{
    ViewData["Title"] = Model.Title;
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwner = Model.UploaderId == userId;
}

<link rel="stylesheet" href="~/css/likes.css" asp-append-version="true" />
@Html.AntiForgeryToken()

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row g-4">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.CoverImagePath))
        {
            <img src="@Url.Action("Cover", "Media", new { id = Model.Id })" alt="Cover" class="img-fluid rounded" />
        }
    </div>
    <div class="col-md-8">
        <h1 class="h3">@Model.Title</h1>
        <p class="text-muted mb-1">by @Model.Uploader?.FullName</p>
        <p class="mb-1">Genre: @(Model.Genre ?? "Not set")</p>
        <p class="mb-3">Uploaded: @Model.UploadedAt.ToString("MMM d, yyyy")</p>
        <p>@Model.Description</p>
        <audio controls src="@Url.Action("Audio", "Media", new { id = Model.Id })" class="w-100 my-3"></audio>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="tt">
                <partial name="_LikeButton" model="@(new IskolarTunes.ViewModels.LikeButtonViewModel
                         {
                             TrackId = Model.Id,
                             Liked = Model.Likes.Any(l => l.UserId == userId),
                             Count = Model.Likes.Count
                         })" />
            </div>

            @if (isOwner)
            {
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
            }
            <a class="btn btn-outline-secondary" asp-action="Index">Back to tracks</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/likes.js" asp-append-version="true"></script>
    <script>
        const player = document.querySelector('audio');
        if (player) {
            // counts one play per page visit, the first time the audio starts
            player.addEventListener('play', () => recordPlay(@Model.Id), { once: true });
        }
    </script>
}