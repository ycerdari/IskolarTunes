@using System.Security.Claims
@model IEnumerable<Track>
@{
    ViewData["Title"] = "Tracks";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<link rel="stylesheet" href="~/css/likes.css" asp-append-version="true" />
@Html.AntiForgeryToken()

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Tracks</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary" asp-action="Create">Upload track</a>
    }
</div>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search title, genre or artist" />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No tracks yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Title</th>
                    <th>Artist</th>
                    <th>Genre</th>
                    <th>Uploaded</th>
                    <th>Likes</th>
                    <th>Play</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="width:64px">
                            @if (!string.IsNullOrEmpty(item.CoverImagePath))
                            {
                                <img src="@Url.Action("Cover", "Media", new { id = item.Id })" alt="Cover" width="56" height="56" style="object-fit:cover;border-radius:6px" />
                            }
                        </td>
                        <td>@item.Title</td>
                        <td>@item.Uploader?.FullName</td>
                        <td>@item.Genre</td>
                        <td>@item.UploadedAt.ToString("MMM d, yyyy")</td>
                        <td>
                            <div class="tt">
                                <partial name="_LikeButton" model="@(new IskolarTunes.ViewModels.LikeButtonViewModel
                                         {
                                             TrackId = item.Id,
                                             Liked = item.Likes.Any(l => l.UserId == currentUserId),
                                             Count = item.Likes.Count
                                         })" />
                            </div>
                        </td>
                        <td><audio controls preload="none" data-track-id="@item.Id" src="@Url.Action("Audio", "Media", new { id = item.Id })" style="max-width:220px"></audio></td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                            @if (item.UploaderId == currentUserId)
                            {
                                <span> | </span>
                                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                <span> | </span>
                                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script src="~/js/likes.js" asp-append-version="true"></script>
    <script>
        (() => {
            // one play counted per track per page visit; "play" doesn't bubble, so listen in capture mode
            const counted = new Set();
            document.addEventListener('play', (e) => {
                if (!(e.target instanceof HTMLAudioElement)) return;
                const id = e.target.dataset.trackId;
                if (id && !counted.has(id)) {
                    counted.add(id);
                    recordPlay(id);
                }
            }, true);
        })();
    </script>
}