@model IskolarTunes.ViewModels.LikeButtonViewModel

<button type="button"
        class="tt-like @(Model.Liked ? "is-liked" : "")"
        data-track-id="@Model.TrackId"
        aria-pressed="@Model.Liked.ToString().ToLower()"
        aria-label="Like this track">
    <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8"></path>
    </svg>
    <span class="tt-count">@Model.Count</span>
</button>