@model Track
@{
    ViewData["Title"] = "Delete track";
}

<h1 class="h3">Delete track</h1>
<p class="text-danger">Are you sure you want to delete this track? This also removes its files.</p>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>
    <dt class="col-sm-2">Artist</dt>
    <dd class="col-sm-10">@Model.Uploader?.FullName</dd>
    <dt class="col-sm-2">Genre</dt>
    <dd class="col-sm-10">@Model.Genre</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>