@using Microsoft.AspNetCore.Authentication
@model IList<AuthenticationScheme>
@if (Model != null && Model.Count > 0)
{
    <span class="it-auth-or">@(ViewData["ExternalHeading"] ?? "Or continue with")</span>
    <form id="external-account" asp-area="Identity" asp-page="/Account/ExternalLogin"
          asp-route-returnUrl="@(ViewData["ReturnUrl"] as string)" method="post" class="it-auth-external">
        @foreach (var provider in Model)
        {
            <button type="submit" class="it-auth-gb" name="provider" value="@provider.Name"
                    title="Log in using your @provider.DisplayName account">
                @if (provider.Name == "Google")
                {
                    <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.7 6c4.5-4.2 6.9-10.3 6.9-17.7z"></path><path fill="#FBBC05" d="M10.5 28.7c-.5-1.5-.8-3-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.9-6.1z"></path><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.7-6c-2.2 1.4-4.9 2.3-8.2 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"></path></svg>
                }
                else if (provider.Name == "Microsoft")
                {
                    <svg width="18" height="18" viewBox="0 0 21 21" aria-hidden="true"><rect width="10" height="10" fill="#F25022"></rect><rect x="11" width="10" height="10" fill="#7FBA00"></rect><rect y="11" width="10" height="10" fill="#00A4EF"></rect><rect x="11" y="11" width="10" height="10" fill="#FFB900"></rect></svg>
                }
                @provider.DisplayName
            </button>
        }
    </form>
}