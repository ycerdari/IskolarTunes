@{
    var ctrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    string Active(string name) => ctrl == name ? " active" : string.Empty;
    string? Current(string name) => ctrl == name ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IskolarTunes</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/icon-192.png" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <script type="importmap"></script>
    <script>
        (function () {
            var theme = 'light';
            try {
                var saved = localStorage.getItem('it-theme');
                if (saved === 'dark' || saved === 'light') {
                    theme = saved;
                } else if (typeof window.matchMedia === 'function'
                    && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            } catch (e) { }
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IskolarTunes.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="it-header">
        <div class="it-header-inner">
            <a class="it-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="it-logo" aria-hidden="true">I</span>
                <span>IskolarTunes</span>
            </a>

            <button class="it-icon-btn it-menu-btn d-lg-none" type="button"
                    data-bs-toggle="collapse" data-bs-target="#itNav"
                    aria-controls="itNav" aria-expanded="false" aria-label="Toggle navigation">
                <svg class="it-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
            </button>

            <div class="it-header-collapse collapse d-lg-flex" id="itNav">
                <nav class="it-tabs" aria-label="Main">
                    <a class="it-tab@(Active("home"))" aria-current="@Current("home")" asp-area="" asp-controller="Home" asp-action="Index">Discover</a>
                    <a class="it-tab@(Active("tracks"))" aria-current="@Current("tracks")" asp-area="" asp-controller="Tracks" asp-action="Index">Tracks</a>
                    <a class="it-tab@(Active("playlists"))" aria-current="@Current("playlists")" asp-area="" asp-controller="Playlists" asp-action="Index">Library</a>
                </nav>

                <form class="it-search ms-lg-auto" role="search" asp-area="" asp-controller="Tracks" asp-action="Index" method="get">
                    <svg class="it-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16M21 21l-4.3-4.3"></path></svg>
                    <input type="search" name="search" aria-label="Search" placeholder="Search songs, artists" />
                </form>

                <div class="it-actions">
                    <a class="it-pill it-pill-ghost" asp-area="" asp-controller="Tracks" asp-action="Index">Browse catalogues</a>
                    <button type="button" id="themeToggle" class="it-icon-btn" aria-label="Switch to dark mode" title="Switch to dark mode">
                        <svg class="it-icon it-theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8"></path></svg>
                        <svg class="it-icon it-theme-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path></svg>
                    </button>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </header>

    <main role="main" class="it-main">
        @RenderBody()
    </main>

    <footer class="it-footer">
        &copy; 2026 - IskolarTunes - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>