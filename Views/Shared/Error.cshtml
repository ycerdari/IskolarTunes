@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="it-error it-card">
    <div class="it-kicker">SOMETHING WENT WRONG</div>
    <h1>Sorry, we hit a problem.</h1>
    <p>An error occurred while processing your request. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a class="it-pill" asp-controller="Home" asp-action="Index">Back to home</a>
</div>