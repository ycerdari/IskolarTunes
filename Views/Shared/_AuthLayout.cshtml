<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IskolarTunes</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/images/icon-192.png" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <script>
        (function () {
            var theme = 'light';
            try {
                var saved = localStorage.getItem('it-theme');
                if (saved === 'dark' || saved === 'light') {
                    theme = saved;
                } else if (typeof window.matchMedia === 'function'
                    && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            } catch (e) { }
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IskolarTunes.styles.css" asp-append-version="true" />
</head>
<body>
    <main class="it-auth" role="main">
        <button type="button" id="themeToggle" class="it-auth-toggle">
            <span class="it-theme-moon">Switch to dark mode</span>
            <span class="it-theme-sun">Switch to light mode</span>
        </button>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>