@model Playlist
@{
    ViewData["Title"] = "Delete playlist";
}

<h1 class="h3">Delete playlist</h1>
<p class="text-danger">Are you sure you want to delete this playlist? The tracks themselves are not deleted.</p>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Owner</dt>
    <dd class="col-sm-10">@Model.Owner?.FullName</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>